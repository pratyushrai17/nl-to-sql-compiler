# Example configuration for the OPTIONAL live LLM mode.
#
# This program does NOT read .env files: it reads these values from the
# process environment only. Set them in your shell (see README.md), e.g. in
# Windows PowerShell:
#     $env:ANTHROPIC_API_KEY = "<your key>"
#
# Never commit a real key. .env is listed in .gitignore.

# Your Anthropic API key. Leave unset to run fully offline in STUB MODE.
ANTHROPIC_API_KEY=

# Optional: model used for SQL generation (default: claude-sonnet-5-5).
ANTHROPIC_MODEL=claude-sonnet-5-5
